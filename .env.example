# Browser -> backend (public: it is embedded in the JS bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Next.js server (SSR of /consulta, ISR of /transparencia) -> backend. In Docker Compose use http://backend:3001/api/v1
API_URL_INTERNAL=http://localhost:3001/api/v1
# Optional: socket.io origin if it differs from the API origin (default: NEXT_PUBLIC_API_URL without /api/v1)
NEXT_PUBLIC_SOCKET_URL=
# NOTE: the staff key is NOT an env var here. Staff type it in /funcionario and it lives only in sessionStorage.
